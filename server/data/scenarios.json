  {
    "id": "S15",
    "slug": "hostile-condition",
    "kind": "hostile",
    "title": "A hostile condition is refused, not run",
    "takeaway": "Deep nesting and huge conditions stop at fixed limits with a clear error. Nothing recurses past them and nothing is evaluated.",
    "rules": [
      "limits"
    ],
    "routes": [],
    "steps": [
      {
        "op": "condition",
        "say": "200 nested parentheses.",
        "condition": {
          "nest": {
            "open": "(",
            "close": ")",
            "core": "true",
            "n": 200
          }
        },
        "request": {
          "url": "/"
        },
        "expect": {
          "ok": false,
          "phase": "parse",
          "code": "too_deep"
        }
      },
      {
        "op": "condition",
        "say": "A condition of 3,000+ characters.",
        "condition": {
          "chain": {
            "term": "true",
            "sep": " and ",
            "n": 600
          }
        },
        "request": {
          "url": "/"
        },
        "expect": {
          "ok": false,
          "phase": "parse",
          "code": "too_long"
        }
      }
    ]
  },
