[
  {
    "id": "S01",
    "slug": "route-hit-by-host",
    "kind": "match",
    "title": "Same path, chosen by host",
    "takeaway": "Two routes match the same path. The host condition makes the door route win for its own host, and every other host falls through to the main route.",
    "rules": [
      "order-by-name"
    ],
    "routes": [
      {
        "name": "a-door",
        "condition": "${find(request.uri.path, '^/mcp') and not empty request.headers['Host'] and find(request.headers['Host'][0], '^{{hostRegex}}$')}",
        "heap": [
          {
            "name": "DoorResolver",
            "type": "TokenIntrospectionAccessTokenResolver",
            "config": {
              "endpoint": "https://as.gw-lab.example/introspect",
              "providerHandler": {
                "type": "ClientHandler"
              }
            }
          },
          {
            "name": "DoorResourceServerFilter",
            "type": "OAuth2ResourceServerFilter",
            "config": {
              "requireHttps": true,
              "scopes": [
                "{{scopeRead}}"
              ],
              "accessTokenResolver": "DoorResolver"
            }
          }
        ],
        "handler": {
          "type": "Chain",
          "config": {
            "filters": [
              "DoorResourceServerFilter"
            ]
          }
        },
        "lab": {
          "audience": "{{audience}}",
          "metadataUrl": "{{metadataUrl}}",
          "challengeStyle": "space"
        }
      },
      {
        "name": "b-main",
        "condition": "${find(request.uri.path, '^/mcp')}",
        "handler": {
          "type": "Chain",
          "config": {
            "filters": []
          }
        }
      }
    ],
    "steps": [
      {
        "op": "match",
        "say": "Request to the door host.",
        "request": {
          "url": "/mcp/{{svc}}",
          "headers": {
            "Host": "{{host}}"
          }
        },
        "expect": {
          "first": "a-door",
          "shadowed": [
            "b-main"
          ],
          "responseStatus": 200
        }
      },
      {
        "op": "match",
        "say": "Same path, another host.",
        "request": {
          "url": "/mcp/{{svc}}",
          "headers": {
            "Host": "{{otherHost}}"
          }
        },
        "expect": {
          "first": "b-main",
          "matches": [
            "b-main"
          ]
        }
      }
    ]
  },
  {
    "id": "S02",
    "slug": "route-miss",
    "kind": "match",
    "title": "No route matches: a bare 404",
    "takeaway": "When no condition is true the gateway answers 404 with no body and no hint. The lab shows each condition and why it was false.",
    "rules": [
      "bare-404"
    ],
    "routes": "seed",
    "steps": [
      {
        "op": "match",
        "say": "A path nothing serves.",
        "request": {
          "url": "/nothing/here",
          "headers": {
            "Host": "mcp.gw-lab.example"
          }
        },
        "expect": {
          "first": null,
          "matches": [],
          "responseStatus": 404
        }
      }
    ]
  },
  {
    "id": "S03",
    "slug": "ordering-conflict",
    "kind": "match",
    "title": "A broad route sorts first and shadows the specific one",
    "takeaway": "Both routes match /mcp/{{svc}}. The lab assumes routes are tried in name order, so the broad one answers and the specific one never does. Renaming fixes it.",
    "rules": [
      "order-by-name"
    ],
    "routes": [
      {
        "name": "aa-broad",
        "condition": "${find(request.uri.path, '^/mcp')}",
        "handler": {
          "type": "Chain",
          "config": {
            "filters": []
          }
        }
      },
      {
        "name": "zz-specific",
        "condition": "${find(request.uri.path, '^/mcp/{{svc}}')}",
        "handler": {
          "type": "Chain",
          "config": {
            "filters": []
          }
        }
      }
    ],
    "steps": [
      {
        "op": "match",
        "say": "Broad route first.",
        "request": {
          "url": "/mcp/{{svc}}/search",
          "headers": {
            "Host": "{{host}}"
          }
        },
        "expect": {
          "first": "aa-broad",
          "shadowed": [
            "zz-specific"
          ]
        }
      },
      {
        "op": "match",
        "say": "After renaming the specific route to sort first.",
        "routes": [
          {
            "name": "aa-broad",
            "condition": "${find(request.uri.path, '^/mcp')}",
            "handler": {
              "type": "Chain",
              "config": {
                "filters": []
              }
            }
          },
          {
            "name": "0-specific",
            "condition": "${find(request.uri.path, '^/mcp/{{svc}}')}",
            "handler": {
              "type": "Chain",
              "config": {
                "filters": []
              }
            }
          }
        ],
        "request": {
          "url": "/mcp/{{svc}}/search",
          "headers": {
            "Host": "{{host}}"
          }
        },
        "expect": {
          "first": "0-specific",
          "shadowed": [
            "aa-broad"
          ]
        }
      }
    ]
  },
  {
    "id": "S04",
    "slug": "dot-escape-trap",
    "kind": "trap",
    "title": "The \\. trap: one backslash and the route is gone",
    "takeaway": "Inside a quoted condition string only \\' and \\\\ are legal escapes. Writing the natural regex \\. makes the condition unparseable, the route is not loaded, and requests get a bare 404 while everything else looks fine.",
    "rules": [
      "invalid-escape"
    ],
    "routes": [
      {
        "name": "trap-door",
        "condition": "${not empty request.headers['Host'] and find(request.headers['Host'][0], '^{{hostRegexEscaped}}$')}",
        "handler": {
          "type": "Chain",
          "config": {
            "filters": []
          }
        }
      }
    ],
    "steps": [
      {
        "op": "condition",
        "say": "The condition as written.",
        "condition": "${not empty request.headers['Host'] and find(request.headers['Host'][0], '^{{hostRegexEscaped}}$')}",
        "request": {
          "url": "/mcp",
          "headers": {
            "Host": "{{host}}"
          }
        },
        "expect": {
          "ok": false,
          "phase": "parse",
          "code": "invalid_escape",
          "igEffect": "route_not_loaded"
        }
      },
      {
        "op": "match",
        "say": "The request it should have served.",
        "request": {
          "url": "/mcp",
          "headers": {
            "Host": "{{host}}"
          }
        },
        "expect": {
          "first": null,
          "notLoaded": [
            "trap-door"
          ],
          "responseStatus": 404
        }
      }
    ]
  },
  {
    "id": "S05",
    "slug": "dot-fix-character-class",
    "kind": "trap",
    "title": "The fix: [.] instead of \\.",
    "takeaway": "A character class matches a literal dot with no escape at all, so the condition parses and the route loads.",
    "rules": [
      "invalid-escape"
    ],
    "routes": [
      {
        "name": "fixed-door",
        "condition": "${not empty request.headers['Host'] and find(request.headers['Host'][0], '^{{hostRegex}}$')}",
        "handler": {
          "type": "Chain",
          "config": {
            "filters": []
          }
        }
      }
    ],
    "steps": [
      {
        "op": "match",
        "say": "Same request, fixed condition.",
        "request": {
          "url": "/mcp",
          "headers": {
            "Host": "{{host}}"
          }
        },
        "expect": {
          "first": "fixed-door",
          "notLoaded": [],
          "responseStatus": 200
        }
      }
    ]
  },
  {
    "id": "S06",
    "slug": "lookahead-exclusion",
    "kind": "match",
    "title": "A negative lookahead keeps other doors out",
    "takeaway": "The main route excludes /mcp/invest and /mcp/weather with (?!...). Those paths fall to their own routes; everything else under /mcp goes to main.",
    "rules": [
      "order-by-name"
    ],
    "routes": [
      {
        "name": "a-main",
        "condition": "${find(request.uri.path, '^/mcp(?!/invest|/weather)')}",
        "handler": {
          "type": "Chain",
          "config": {
            "filters": []
          }
        }
      },
      {
        "name": "b-invest",
        "condition": "${find(request.uri.path, '^/mcp/invest')}",
        "handler": {
          "type": "Chain",
          "config": {
            "filters": []
          }
        }
      }
    ],
    "steps": [
      {
        "op": "match",
        "say": "/mcp/invest goes to its own route.",
        "request": {
          "url": "/mcp/invest/quote",
          "headers": {
            "Host": "{{host}}"
          }
        },
        "expect": {
          "first": "b-invest",
          "matches": [
            "b-invest"
          ]
        }
      },
      {
        "op": "match",
        "say": "Anything else under /mcp goes to main.",
        "request": {
          "url": "/mcp/{{svc}}",
          "headers": {
            "Host": "{{host}}"
          }
        },
        "expect": {
          "first": "a-main",
          "matches": [
            "a-main"
          ]
        }
      }
    ]
  },
  {
    "id": "S07",
    "slug": "comma-before-first-param",
    "kind": "lint",
    "title": "The challenge that broke a client: \"Bearer , resource_metadata\"",
    "takeaway": "A script appended \", resource_metadata=...\" to a param-less Bearer. The first auth-param is empty. One real client rejected it (reported earlier, not re-measured here).",
    "rules": [
      "WA001"
    ],
    "routes": [
      {
        "name": "door-bug",
        "condition": "${find(request.uri.path, '^/mcp') and not empty request.headers['Host'] and find(request.headers['Host'][0], '^{{hostRegex}}$')}",
        "heap": [
          {
            "name": "DoorResolver",
            "type": "TokenIntrospectionAccessTokenResolver",
            "config": {
              "endpoint": "https://as.gw-lab.example/introspect",
              "providerHandler": {
                "type": "ClientHandler"
              }
            }
          },
          {
            "name": "DoorResourceServerFilter",
            "type": "OAuth2ResourceServerFilter",
            "config": {
              "requireHttps": true,
              "scopes": [
                "{{scopeRead}}"
              ],
              "accessTokenResolver": "DoorResolver"
            }
          }
        ],
        "handler": {
          "type": "Chain",
          "config": {
            "filters": [
              "DoorResourceServerFilter"
            ]
          }
        },
        "lab": {
          "audience": "{{audience}}",
          "metadataUrl": "{{metadataUrl}}",
          "challengeStyle": "comma-bug"
        }
      }
    ],
    "steps": [
      {
        "op": "handle",
        "say": "Call with no token.",
        "request": {
          "method": "POST",
          "url": "/mcp/{{svc}}",
          "headers": {
            "Host": "{{host}}"
          }
        },
        "expect": {
          "matched": "door-bug",
          "decision": "deny",
          "responseStatus": 401,
          "hasRules": [
            "WA001"
          ],
          "challenge": "Bearer , resource_metadata=\"{{metadataUrl}}\""
        }
      },
      {
        "op": "lint",
        "say": "The same header as a literal.",
        "header": "Bearer , resource_metadata=\"{{metadataUrl}}\"",
        "status": 401,
        "expect": {
          "clean": false,
          "hasRules": [
            "WA001"
          ]
        }
      }
    ]
  },
