  {
    "id": "S09",
    "slug": "bad-challenge-shapes",
    "kind": "lint",
    "title": "Three ways to break resource_metadata",
    "takeaway": "An http URL, an unquoted URL and a missing hint each fail in a different way.",
    "rules": [
      "WA004",
      "WA006",
      "WA007"
    ],
    "routes": [],
    "steps": [
      {
        "op": "lint",
        "say": "http instead of https.",
        "header": "Bearer resource_metadata=\"http://{{host}}/.well-known/oauth-protected-resource\"",
        "status": 401,
        "expect": {
          "hasRules": [
            "WA007"
          ]
        }
      },
      {
        "op": "lint",
        "say": "URL without quotes.",
        "header": "Bearer resource_metadata={{metadataUrl}}",
        "status": 401,
        "expect": {
          "hasRules": [
            "WA004"
          ]
        }
      },
      {
        "op": "lint",
        "say": "No hint at all.",
        "header": "Bearer realm=\"Gateway Lab\"",
        "status": 401,
        "expect": {
          "hasRules": [
            "WA006"
          ]
        }
      }
    ]
  },
  {
    "id": "S10",
    "slug": "inactive-token",
    "kind": "introspection",
    "title": "Revoked and unknown tokens are inactive",
    "takeaway": "The mock AS answers {\"active\": false} and nothing else for a revoked or unknown token. The route turns that into 401 invalid_token.",
    "rules": [
      "rfc7662-inactive"
    ],
    "routes": [
      {
        "name": "door-ok",
        "condition": "${find(request.uri.path, '^/mcp') and not empty request.headers['Host'] and find(request.headers['Host'][0], '^{{hostRegex}}$')}",
        "heap": [
          {
            "name": "DoorResolver",
            "type": "TokenIntrospectionAccessTokenResolver",
            "config": {
              "endpoint": "https://as.gw-lab.example/introspect",
              "providerHandler": {
                "type": "ClientHandler"
              }
            }
          },
          {
            "name": "DoorResourceServerFilter",
            "type": "OAuth2ResourceServerFilter",
            "config": {
              "requireHttps": true,
              "scopes": [
                "{{scopeRead}}"
              ],
              "accessTokenResolver": "DoorResolver"
            }
          }
        ],
        "handler": {
          "type": "Chain",
          "config": {
            "filters": [
              "DoorResourceServerFilter"
            ]
          }
        },
        "lab": {
          "audience": "{{audience}}",
          "metadataUrl": "{{metadataUrl}}",
          "challengeStyle": "space"
        }
      }
    ],
    "steps": [
      {
        "op": "issue",
        "say": "Issue a good token.",
        "as": "t1",
        "client_id": "{{client}}",
        "scope": "{{scopeRead}}",
        "aud": "{{audience}}",
        "expect": {
          "status": 200
        }
      },
      {
        "op": "handle",
        "say": "It works.",
        "request": {
          "method": "POST",
          "url": "/mcp/{{svc}}",
          "headers": {
            "Host": "{{host}}",
            "Authorization": "Bearer @t1"
          }
        },
        "expect": {
          "decision": "allow",
          "responseStatus": 200,
          "reason": "token_ok"
        }
      },
      {
        "op": "revoke",
        "say": "Revoke it.",
        "token": "t1",
        "expect": {}
      },
      {
        "op": "handle",
        "say": "Now the AS says inactive.",
        "request": {
          "method": "POST",
          "url": "/mcp/{{svc}}",
          "headers": {
            "Host": "{{host}}",
            "Authorization": "Bearer @t1"
          }
        },
        "expect": {
          "decision": "deny",
          "responseStatus": 401,
          "reason": "inactive_token",
          "introspection": {
            "active": false
          },
          "clean": true
        }
      },
      {
        "op": "handle",
        "say": "A token the AS never issued.",
        "request": {
          "method": "POST",
          "url": "/mcp/{{svc}}",
          "headers": {
            "Host": "{{host}}",
            "Authorization": "Bearer mock-tok-000000000000000000000000"
          }
        },
        "expect": {
          "reason": "inactive_token"
        }
      }
    ]
  },
  {
    "id": "S11",
    "slug": "expired-token",
    "kind": "introspection",
    "title": "A token expires on the virtual clock",
    "takeaway": "Nothing sleeps: the lab moves its own clock. At exp the AS says inactive.",
    "rules": [
      "rfc7662-exp"
    ],
    "routes": [
      {
        "name": "door-ok",
        "condition": "${find(request.uri.path, '^/mcp') and not empty request.headers['Host'] and find(request.headers['Host'][0], '^{{hostRegex}}$')}",
        "heap": [
          {
            "name": "DoorResolver",
            "type": "TokenIntrospectionAccessTokenResolver",
            "config": {
              "endpoint": "https://as.gw-lab.example/introspect",
              "providerHandler": {
                "type": "ClientHandler"
              }
            }
          },
          {
            "name": "DoorResourceServerFilter",
            "type": "OAuth2ResourceServerFilter",
            "config": {
              "requireHttps": true,
              "scopes": [
                "{{scopeRead}}"
              ],
              "accessTokenResolver": "DoorResolver"
            }
          }
        ],
        "handler": {
          "type": "Chain",
          "config": {
            "filters": [
              "DoorResourceServerFilter"
            ]
          }
        },
        "lab": {
          "audience": "{{audience}}",
          "metadataUrl": "{{metadataUrl}}",
          "challengeStyle": "space"
        }
      }
    ],
    "steps": [
      {
        "op": "issue",
        "say": "A 60-second token.",
        "as": "t1",
        "scope": "{{scopeRead}}",
        "aud": "{{audience}}",
        "ttl": 60,
        "expect": {
          "status": 200
        }
      },
      {
        "op": "handle",
        "say": "Fresh.",
        "request": {
          "method": "POST",
          "url": "/mcp/{{svc}}",
          "headers": {
            "Host": "{{host}}",
            "Authorization": "Bearer @t1"
          }
        },
        "expect": {
          "decision": "allow"
        }
      },
      {
        "op": "advance",
        "say": "Move the clock 61 seconds.",
        "seconds": 61,
        "expect": {}
      },
      {
        "op": "handle",
        "say": "Expired.",
        "request": {
          "method": "POST",
          "url": "/mcp/{{svc}}",
          "headers": {
            "Host": "{{host}}",
            "Authorization": "Bearer @t1"
          }
        },
        "expect": {
          "decision": "deny",
          "responseStatus": 401,
          "reason": "inactive_token"
        }
      }
    ]
  },
