        "op": "issue",
        "say": "A token for another API.",
        "as": "t1",
        "scope": "{{scopeRead}}",
        "aud": "https://{{otherHost}}/api",
        "expect": {
          "status": 200
        }
      },
      {
        "op": "handle",
        "say": "Presented here.",
        "request": {
          "method": "POST",
          "url": "/mcp/{{svc}}",
          "headers": {
            "Host": "{{host}}",
            "Authorization": "Bearer @t1"
          }
        },
        "expect": {
          "decision": "deny",
          "responseStatus": 401,
          "reason": "wrong_audience",
          "introspection": {
            "active": true
          }
        }
      }
    ]
  },
