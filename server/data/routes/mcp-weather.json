{
  "name": "mcp-weather",
  "comment": "Weather tools; no token check on this route.",
  "condition": "${find(request.uri.path, '^/mcp/weather')}",
  "handler": {
    "type": "Chain",
    "config": {
      "filters": [
        {
          "name": "Audit",
          "type": "AuditFilter"
        },
        {
          "name": "PathRewrite",
          "type": "UriPathRewriteFilter"
        },
        {
          "name": "ProtocolCheck",
          "type": "ProtocolValidationFilter"
        }
      ]
    }
  }
}
