{
  "name": "mcp-invest-jwks",
  "comment": "Invest tools, token checked by signature when the caller asks for it by header.",
  "condition": "${find(request.uri.path, '^/mcp/invest') and not empty request.headers['X-Token-Validation'] and request.headers['X-Token-Validation'][0] == 'jwks'}",
  "handler": {
    "type": "Chain",
    "config": {
      "filters": [
        {
          "name": "Audit",
          "type": "AuditFilter"
        },
        {
          "name": "PathRewrite",
          "type": "UriPathRewriteFilter"
        },
        {
          "name": "JwksCheck",
          "type": "ScriptableFilter",
          "config": {
            "type": "application/x-groovy",
            "file": "jwks-check.groovy"
          }
        },
        {
          "name": "ProtocolCheck",
          "type": "ProtocolValidationFilter"
        },
        {
          "name": "Exchange",
          "type": "OAuth2TokenExchangeFilter"
        }
      ]
    }
  }
}
